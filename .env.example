# Email alerts from the daily watcher (scripts/watch-foscos.mjs). Copy to .env (never committed).
# Gmail: turn on 2-step verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it here (16 letters, spaces are fine).
MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where alerts go (defaults to MAIL_USER)
MAIL_TO=you@gmail.com
# Optional: MAIL_HOST=smtp.gmail.com  MAIL_PORT=465  MAIL_SECURE=1
